# This bot is a companion process for the SNG ONE loadboard (github.com/AbdulloxAbdujalilov9999/sng-loadboard).
# It shares that app's PostgreSQL database and talks to its HTTP API; it is not useful on its own.

# ---- required ---------------------------------------------------------------
# Create a bot with @BotFather on Telegram, then paste its token here.
TELEGRAM_BOT_TOKEN=
# Same database the sng-loadboard API uses (its migrations, including 006_telegram.sql in this
# repo's migrations/ folder, must already be applied - the sng-loadboard API does that automatically).
DATABASE_URL=postgres://sng:change-me@localhost:5432/sng
DATABASE_SSL=false
# The *public* Firebase Web API key - the same "apiKey" sng-loadboard's web/js/config.js uses.
# Letting the bot exchange a member's e-mail+password for a session is exactly what that app's own
# sign-in form does; the key does not grant any extra privilege.
FIREBASE_WEB_API_KEY=AIzaSyDryrZCdCuYNZrx8PQe83U4x3YL0Ipz3Hg
# Where the bot sends load-posting requests - the running sng-loadboard API.
API_BASE_URL=http://127.0.0.1:8080
# The address a person's browser can reach, used to build each load's "view on the loadboard" link.
# Only needed if it differs from API_BASE_URL (e.g. the bot talks to the API over an internal
# address, as on Render) - otherwise it defaults to API_BASE_URL. Must be a public https:// address
# in production, or "view this load" links are left out of every message.
PUBLIC_WEB_URL=
# 32 random bytes, base64 - encrypts each linked member's refresh token at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BOT_ENCRYPTION_KEY=

# ---- optional tuning (defaults shown) ---------------------------------------
NODE_ENV=production
FIREBASE_PROJECT_ID=sng-pro
LOG_LEVEL=info
# Spacing between consecutive Telegram sends while broadcasting one load to many chats.
BOT_BROADCAST_SPACING_MS=60
# Language used for messages broadcast to groups (en/ru/uz) - a group mixes people, so there is no
# single "this chat's language" to follow the way DMs follow each person's own /language choice.
BOT_BROADCAST_LANG=uz
# Our own official channel/group, invited in the welcome message, the /postload confirmation, and
# every broadcast message. Optional - leave blank to omit. No leading "@" needed (stripped if given).
BOT_JOIN_CHANNEL=sngOne_yuklar
BOT_JOIN_GROUP=sngOne_yuklarr

# ---- Telegram ingest bot (src/ingestIndex.js) -------------------------------
# A SEPARATE bot + process from the one above: joins big public freight-posting groups (not your
# own broadcast chats) and auto-posts loads it reads there, using the same AI parser (Gemini) that
# the web app's "paste from Telegram" screen uses. See README.md "Ingestion bot" before running
# this - it needs its own @BotFather bot with privacy mode DISABLED, and a dedicated member account
# you sign up and approve on the sng-loadboard web app first. Make sure migration
# 007_telegram_ingest.sql has been applied (automatic if the sng-loadboard API runs with
# AUTO_MIGRATE=true, the default).
TELEGRAM_INGEST_BOT_TOKEN=
# E-mail + password of a member account you sign up and approve yourself - every auto-imported load
# is posted as this account, and its profile supplies fallback contact details.
INGEST_SERVICE_EMAIL=
INGEST_SERVICE_PASSWORD=
# Skip messages shorter than this before spending an AI call.
INGEST_MIN_CHARS=25
# Skip messages with no phone number or @handle at all (most non-load chatter). Set to false only
# if a source group's loads commonly omit contact info.
INGEST_REQUIRE_CONTACT=true
# How long (hours) the same route + pickup date + contact blocks a repost from becoming a second load.
INGEST_DEDUPE_WINDOW_HOURS=72
# Caps how often this bot calls the AI parser, independent of how busy a source group gets - keep
# this below your Gemini quota/budget.
INGEST_AI_MAX_PER_MIN=6
# Comma-separated Telegram user ids allowed to DM this bot /ingeststatus, /pausesource, /resumesource.
# Get your own id from @userinfobot on Telegram.
INGEST_ADMIN_TG_IDS=
