# This bot is a companion process for the SNG ONE loadboard (github.com/AbdulloxAbdujalilov9999/sng-loadboard).
# It shares that app's PostgreSQL database and talks to its HTTP API; it is not useful on its own.

# ---- required ---------------------------------------------------------------
# Create a bot with @BotFather on Telegram, then paste its token here.
TELEGRAM_BOT_TOKEN=
# Same database the sng-loadboard API uses (its migrations, including 006_telegram.sql in this
# repo's migrations/ folder, must already be applied - the sng-loadboard API does that automatically).
DATABASE_URL=postgres://sng:change-me@localhost:5432/sng
DATABASE_SSL=false
# The *public* Firebase Web API key - the same "apiKey" sng-loadboard's web/js/config.js uses.
# Letting the bot exchange a member's e-mail+password for a session is exactly what that app's own
# sign-in form does; the key does not grant any extra privilege.
FIREBASE_WEB_API_KEY=AIzaSyDryrZCdCuYNZrx8PQe83U4x3YL0Ipz3Hg
# Where the bot sends load-posting requests - the running sng-loadboard API.
API_BASE_URL=http://127.0.0.1:8080
# The address a person's browser can reach, used to build each load's "view on the loadboard" link.
# Only needed if it differs from API_BASE_URL (e.g. the bot talks to the API over an internal
# address, as on Render) - otherwise it defaults to API_BASE_URL. Must be a public https:// address
# in production, or "view this load" links are left out of every message.
PUBLIC_WEB_URL=
# 32 random bytes, base64 - encrypts each linked member's refresh token at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BOT_ENCRYPTION_KEY=

# ---- optional tuning (defaults shown) ---------------------------------------
NODE_ENV=production
FIREBASE_PROJECT_ID=sng-pro
LOG_LEVEL=info
# Spacing between consecutive Telegram sends while broadcasting one load to many chats.
BOT_BROADCAST_SPACING_MS=60
# Language used for messages broadcast to groups (en/ru/uz) - a group mixes people, so there is no
# single "this chat's language" to follow the way DMs follow each person's own /language choice.
BOT_BROADCAST_LANG=en
